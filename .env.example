# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres. Neon, Supabase, Railway and Vercel Postgres all work.
# Use the POOLED connection string on serverless hosts.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# The password you sign in with.
APP_PASSWORD="choose-a-long-password"

# Encrypts broker credentials at rest. At least 32 characters.
#   openssl rand -base64 48
ENCRYPTION_KEY=""

# Signs the session cookie. At least 32 characters. Generate separately
# from ENCRYPTION_KEY — rotating one should not invalidate the other.
SESSION_SECRET=""

# Bearer token for the scheduled jobs and the TradingView webhook.
#   openssl rand -hex 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set to 1 to build a standalone server image (Railway, Fly, Docker).
# Leave unset on Vercel.
# BUILD_STANDALONE=1

# Enables the AI trade reviewer on the Models page (checks trades against your
# written trading models, reads chart screenshots, auto-tags trades). Get a key
# at console.anthropic.com; usage bills to the key — roughly a cent or two per
# trade review. Everything else works without it.
# ANTHROPIC_API_KEY=""

# Which Claude model reviews trades. Defaults to claude-sonnet-5.
# AI_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Email automation (optional)
# ---------------------------------------------------------------------------
#
# Reads your prop-firm mail on a schedule and logs payouts, evaluation fees,
# account passes and failures, daily balances and subscription changes.
#
# Use a Google app password, not your account password: turn on 2-Step
# Verification, then create one at myaccount.google.com/apppasswords. It only
# reads mail, and revoking it does not touch anything else. Mailboxes are
# opened read-only, so the app cannot send, label or delete.
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="abcdefghijklmnop"

# Several inboxes: number the pairs. Prop-firm accounts end up spread across
# addresses, and every numbered inbox is read on the same schedule.
# GMAIL_USER_1="you@gmail.com"
# GMAIL_APP_PASSWORD_1="abcdefghijklmnop"
# GMAIL_USER_2="other@gmail.com"
# GMAIL_APP_PASSWORD_2="qrstuvwxyzabcdef"

# Or as one variable, `address:apppassword` per line or comma.
# GMAIL_ACCOUNTS="second@gmail.com:abcdefghijklmnop"

# Any other IMAP host, if the mail is not on Gmail. Defaults to imap.gmail.com.
# IMAP_HOST="imap.gmail.com"

# Token for posting pre-extracted events to /api/ingest/email from outside the
# app (a mail webhook, a forwarder). The scheduled job does not need it.
# INGEST_SECRET=""
