{
  "name": "trading-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server src/db/seed.ts",
    "check": "npm run typecheck && npm run test",
    "check:integration": "tsx --conditions=react-server scripts/integration-check.mts",
    "check:email": "tsx --conditions=react-server scripts/email-check.mts",
    "push:keys": "node -e \"const w=require('web-push');const k=w.generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey);console.log('VAPID_PRIVATE_KEY='+k.privateKey)\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@neondatabase/serverless": "^0.10.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.38.4",
    "eslint-config-next": "^15.5.23",
    "imapflow": "^1.7.2",
    "jose": "^5.9.6",
    "mailparser": "^3.9.15",
    "next": "^15.5.23",
    "papaparse": "^5.4.1",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "22.x"
  }
}
